{
  "name": "zabbix-vim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vim-style keyboard navigation and hint mode for the Zabbix frontend.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check dist/chromium/content.js && node --check dist/firefox/content.js",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
